# Public browser configuration only. Use the Supabase Project URL and publishable key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Legacy projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
# Never put a Supabase secret/service_role key in a NEXT_PUBLIC_ variable.
